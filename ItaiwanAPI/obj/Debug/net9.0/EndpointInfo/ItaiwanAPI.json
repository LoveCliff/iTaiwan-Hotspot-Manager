              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Favorites"
        ],
        "parameters": [
          {
            "name": "hotspotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
